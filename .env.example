# =============================================================================
# Backend Environment Variables
# =============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# This file is for LOCAL DEVELOPMENT with `air` (hot-reload).
# Docker (production) uses its own environment block in docker-compose.yml.
# =============================================================================

SERVER_PORT=8080
CORS_ALLOW_ORIGIN=*
GIN_MODE=debug # Set to "release" in production for better performance and security.

# Database configuration.
# These values point to the Docker PostgreSQL container exposed on port 15432.
# Run `docker compose up -d` to start the database before running `air`.
DB_HOST=localhost
DB_PORT=15432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=permatatex_inventory
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME_MINUTES=30
DB_MAX_CONN_IDLE_TIME_MINUTES=10
DB_HEALTH_CHECK_PERIOD_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5

# Optional: override all DB_* values with a full DSN.
DB_URL=

# Secrets for JWT and Turnstile. Change these in production!
JWT_SECRET=change-me
TURNSTILE_SECRET=change-me

# Login endpoint rate limiting (per client IP, fixed window).
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Root folder for export templates, relative to backend project root by default.
EXPORT_TEMPLATE_DIR=templates/exports

# Server Timeout.
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Local Docker bind mount for files served from /uploads.
# Production must supply an explicit absolute host path to make prod-deploy.
# See UPLOADS_MIGRATION_RUNBOOK.md before the first production recreate.
UPLOADS_HOST_PATH=./uploads

# Encrypted backup configuration. Leave the six BACKUP_* runtime values empty
# to keep the API unavailable without preventing web startup. Production host
# paths must be absolute and outside this repository; the public key is mounted
# read-only and no private key is used.
BACKUP_DATABASE_URL=
BACKUP_UPLOADS_SOURCE=
BACKUP_DESTINATION=
BACKUP_GPG_PUBLIC_KEY_PATH=
BACKUP_HOST_PATH=
BACKUP_GPG_PUBLIC_KEY_HOST_PATH=
BACKUP_GPG_RECIPIENT=
BACKUP_APP_GIT_COMMIT=unknown
